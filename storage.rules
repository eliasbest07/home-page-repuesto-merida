rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
      match /preguntas_repuestos/{uid}/{archivo} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /verificaciones-edad/{telefono}/{fileName} {
      allow read, write: if false;
    }

    match /solicitudes-debate/{solicitudId}/{telefono}/{fileName} {
      allow read: if true;
      allow create: if request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // ── App móvil ────────────────────────────────────────────────────────
    match /fotos_usuarios/{fileName} {
      allow read: if true;
      allow write: if request.resource.contentType.matches('image/.*');
    }

    match /fotocedula/{fileName} {
      allow read: if true;
      allow write: if request.resource.contentType.matches('image/.*');
    }
    match /fotofacecedula/{fileName} {
      allow read: if true;
      allow write: if request.resource.contentType.matches('image/.*');
    }

    match /imagenrep/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.contentType.matches('image/.*');
    }

    match /solicitudes_repuestos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.contentType.matches('image/.*')
                   || request.resource.contentType.matches('audio/.*');
    }

    match /imagenes_anuncios/{carpeta}/{fileName} {
      allow read: if true;
      allow write: if request.resource.contentType.matches('image/.*');
    }

    // Fotos de "Mis vehículos": galería general por modelo
    // (vehiculos_modelos/carro/chevrolet/optra/...). Cada usuario sube las
    // suyas (el nombre empieza por su uid) y nadie las borra desde la app:
    // quitar una foto del vehículo solo quita la referencia, la foto se queda
    // aquí para ese modelo.
    match /vehiculos_modelos/{tipo}/{marca}/{modelo}/{archivo} {
      allow read: if true;
      allow create: if request.auth != null
                    && archivo.matches(request.auth.uid + '_.*')
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Chat de servicios: fotos y notas de voz. Cada quien sube solo a su
    // carpeta dentro del chat, y la regla de Firestore exige que la URL del
    // mensaje apunte justo aquí (ENCARGO_OSO_CHAT_SERVICIOS.md, repo app).
    match /chats_servicios/{chatId}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 15 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*')
                        || request.resource.contentType.matches('audio/.*'));
      allow update, delete: if false;
    }

    // Galería de quien atiende un servicio (fotos de historia o de piezas).
    match /servicios_proveedores/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Fotos de las solicitudes de servicio (hasta 3 por solicitud; la regla
    // de Firestore exige que la URL apunte a la carpeta de su autor).
    match /solicitudes_servicios/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // ── Web ──────────────────────────────────────────────────────────────
    match /rifas_usuarios/{fileName=**} {
      allow read: if true;
      allow write: if request.resource.contentType.matches('image/.*');
    }

    match /comercios/{fileName} {
      allow read: if true;
      allow write: if request.resource.contentType.matches('image/.*');
    }
  }
}
