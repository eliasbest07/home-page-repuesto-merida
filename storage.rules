rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Documentos de identidad heredados de Flutter. El propietario puede
    // subir/reemplazar; ningún cliente puede leerlos. Firebase Admin conserva
    // acceso para revisión o descarga autorizada.
    match /fotocedula/{uid} {
      allow read: if false;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /fotofacecedula/{uid} {
      allow read: if false;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Fotos públicas de perfil, siempre escritas por su propietario.
    match /fotos_usuarios/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /fotos_usuarios/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && fileName == request.auth.uid + '.jpg'
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && fileName == request.auth.uid + '.jpg';
    }

    match /verificaciones-edad/{telefono}/{fileName} {
      allow read, write: if false;
    }

    match /verificaciones-cedula/{telefono}/{fileName} {
      allow read, write: if false;
    }

    match /solicitudes-debate/{solicitudId}/{telefono}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /solicitudes_repuestos/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 10 * 1024 * 1024
                    && (
                      request.resource.contentType.matches('image/.*')
                      || request.resource.contentType.matches('audio/.*')
                      || request.resource.contentType == 'application/octet-stream'
                    );
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /preguntas_repuestos/{uid}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
