{
  "rules": {
    "anuncios":        { ".read": true, ".write": true },
    "users": {
      ".read": true,
      ".indexOn": ["whatsapp", "telefono"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "verificarCedula": {
      ".read": false,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "fotocedula": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val() === 'fotocedula/' + auth.uid)"
        },
        "fotocaracedula": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val() === 'fotofacecedula/' + auth.uid)"
        },
        "storage_schema_version": {
          ".validate": "!newData.exists() || newData.val() === 2"
        },
        "$other": {
          ".validate": "$other === 'fotocedula' || $other === 'fotocaracedula' || $other === 'storage_schema_version'"
        }
      }
    },

    "identity_index": {
      ".read": false,
      ".write": false
    },

    "aprobarPublicacion": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$pendingId": {
          ".validate": "!newData.exists() || (newData.child('schema_version').val() === 2 && newData.child('owner_uid').val() === auth.uid && newData.child('publicado').val() === 'espera' && newData.child('estado_aprobacion').val() === 'pendiente')"
        }
      }
    },

    "bingoRooms":           { ".read": true, ".write": true },
    "bingoRoomCodes":       { ".read": true, ".write": true },
    "bingoRoomMemberships": { ".read": true, ".write": true },

    "rifas_otps": {
      "$tel": {
        ".read": false,
        ".write": true,
        ".validate": "newData.hasChildren(['codigo','expira_en','tipo','telefono','intent','intentos']) && newData.child('codigo').isString() && newData.child('codigo').val().length >= 40 && newData.child('intentos').isNumber() && newData.child('intentos').val() >= 0 && newData.child('intentos').val() <= 5"
      }
    },

    "rifas_usuarios": {
      ".read": true,
      "$tel": {
        ".write": true,
        ".validate": "newData.hasChildren(['telefono','nombre'])"
      }
    },

    "rifas": {
      ".read": true,
      ".indexOn": ["creador_key"],
      "$rifa": {
        ".write": true,
        "numeros": {
          ".read": true,
          "$num": { ".write": true }
        },
        "vendedores": {
          ".read": true,
          "$vk": { ".write": true }
        }
      }
    },

    "vendedor_index": {
      "$tel": { ".read": true, ".write": true }
    },

    "creador_index": {
      "$tel": { ".read": true, ".write": true }
    }
  }
}
