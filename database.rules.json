{
  "rules": {
    "anuncios":        { ".read": true, ".write": true },
    "cardads":         { ".read": true, ".write": false },

    // Métricas de uso. Cada quien solo puede tocar su propio registro, y nadie
    // puede leer el nodo desde la app: los informes se sacan por consola o con
    // el SDK Admin, que se salta las reglas.
    "metricas": {
      ".read": false,
      ".write": false,
      "sala_club": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".read": "auth != null && auth.uid === $uid",
          "clics": { ".validate": "newData.isNumber()" },
          "primero_en": { ".validate": "newData.isNumber()" },
          "ultimo_en": { ".validate": "newData.isNumber()" },
          "nombre": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$otro": { ".validate": false }
        }
      }
    },
    "configuracion":   { ".read": true, ".write": false },

    // Verificación de WhatsApp al registrarse.
    // El nombre lleva la errata "Whastapp" porque así está escrito en la app:
    // NO corregirla aquí sin cambiarla allá. Sin esta regla la escritura se
    // denegaba y el usuario solo veía "encontraste una falla".
    "verificarWhastappRegistro": {
      ".read": false,
      ".write": false,
      "$numero": {
        ".read": false,
        ".write": false,
        "solicitudes": {
          ".read": false,
          ".write": false,
          // El installId son 48 hex aleatorios que solo conoce este teléfono, y
          // los niveles de arriba están cerrados: nadie puede listar el nodo
          // para descubrir las rutas de otros.
          // El umbral es 16 porque es el que usa `_getOrCreateInstallId` en la
          // app: un teléfono con un id viejo de 16 a 31 caracteres lo conserva,
          // y exigir más aquí le denegaba la escritura.
          // OJO: en Realtime Database `.write` CASCADEA hacia abajo y un hijo
          // NO lo puede revocar. Por eso aquí NO hay `.write`: se concede campo
          // por campo. Un `".write": true` en este nivel dejaría al cliente
          // escribir `resultado` y autoverificarse cualquier número, aunque el
          // hijo dijera `".write": false`.
          "$installId": {
            ".read": true,
            "creado_en": {
              ".write": "$installId.length >= 16",
              ".validate": "newData.isNumber()"
            },
            "codigo_intento": {
              ".write": "$installId.length >= 16",
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "intento_id": {
              ".write": "$installId.length >= 16",
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "intento_en": {
              ".write": "$installId.length >= 16",
              ".validate": "newData.isNumber()"
            }
            // `resultado` no aparece: sin `.write` en él ni en ningún ancestro,
            // solo lo puede escribir el bot con el SDK Admin, que se salta las
            // reglas. Es lo que impide que el cliente se apruebe a sí mismo.
          }
        }
      }
    },
    // Perfil PRIVADO de cada usuario: lo lee y escribe solo su dueño. Lo que
    // tenga que ver todo el mundo (nombre, foto, ciudad, tipo de vendedor)
    // va en `public_profiles`, que se regenera desde aquí. El bot y la API
    // usan el SDK Admin, que se salta estas reglas. Sin `.read` en este nivel
    // nadie puede listar el nodo; el índice sigue sirviendo al Admin.
    "users": {
      ".indexOn": ["whatsapp", "telefono"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        // Taller verificado: lo pone el bot o soporte (Admin, que se salta
        // las reglas). El dueño no se lo puede poner ni cambiar solo; el
        // oso lo lee antes de encender un anuncio de servicio.
        "taller": {
          ".validate": "newData.val() === data.val()"
        }
      }
    },

    // Búsquedas que guarda la app (`enviarSearch` en guardar_seachs.dart):
    // `search/{uid}/{momento} = texto`. Este nodo estaba desplegado en consola
    // pero no en este archivo, y cada deploy desde aquí lo borraba: sin él la
    // raíz deniega la escritura y la app se lo traga en silencio. Un usuario
    // con sesión escribe bajo su uid; uno anónimo solo puede crear (no editar).
    "search": {
      ".read": false,
      ".write": false,
      "$quien": {
        ".write": "auth != null && auth.uid === $quien",
        "$momento": {
          ".write": "auth == null && !data.exists()",
          ".validate": "newData.isString() && newData.val().length <= 120"
        }
      }
    },
    "public_profiles": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['schema_version','record_type','uid','canonical_uid','nombre','foto','foto_url','ciudad','tipovender','vender','actualizado_en']) && newData.child('schema_version').val() === 1 && newData.child('record_type').val() === 'public_profile' && newData.child('uid').val() === $uid)",
        "schema_version": {
          ".validate": "newData.val() === 1"
        },
        "record_type": {
          ".validate": "newData.val() === 'public_profile'"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid && newData.val().length > 0 && newData.val().length <= 128"
        },
        "canonical_uid": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "foto": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "foto_url": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "ciudad": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "tipovender": {
          ".validate": "newData.val() === 'individuo' || newData.val() === 'tienda'"
        },
        "vender": {
          ".validate": "newData.isBoolean()"
        },
        "actualizado_en": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "comercio_id": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "nombre_comercio": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "comercio_foto_url": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "comercio_direccion": {
          ".validate": "newData.isString() && newData.val().length <= 240"
        },
        "comercio_lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "comercio_lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "tipo_vehiculo": {
          ".validate": "newData.val() === 'carro' || newData.val() === 'moto'"
        },
        "whatsapp_public": {
          ".validate": "newData.isString() && ((newData.val() === '' && newData.parent().child('public_contact_enabled').val() === false) || (newData.val().matches(/^\\+[0-9]{12,15}$/) && newData.parent().child('vender').val() === true))"
        },
        "public_contact_enabled": {
          ".validate": "newData.isBoolean() && (newData.val() === false || (newData.parent().child('vender').val() === true && newData.parent().child('whatsapp_public').isString()))"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "verificarCedula": {
      ".read": false,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "fotocedula": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val() === 'fotocedula/' + auth.uid)"
        },
        "fotocaracedula": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val() === 'fotofacecedula/' + auth.uid)"
        },
        "storage_schema_version": {
          ".validate": "!newData.exists() || newData.val() === 2"
        },
        // Marca de "el usuario pulsó enviar" en la app. Es la señal que
        // espera el bot para analizar el par de fotos: sin esto, el nodo solo
        // dice que las fotos se subieron, que ocurre foto por foto y antes de
        // que la persona decidiera mandarlas. Se exige la hora del servidor
        // para que el cliente no pueda antedatar ni postdatar el envío.
        "enviado_en": {
          ".validate": "!newData.exists() || newData.val() === now"
        },
        "$other": {
          ".validate": "$other === 'fotocedula' || $other === 'fotocaracedula' || $other === 'storage_schema_version' || $other === 'enviado_en'"
        }
      }
    },

    "identity_index": {
      ".read": false,
      ".write": false
    },

    "aprobarPublicacion": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$pendingId": {
          ".validate": "!newData.exists() || (newData.child('schema_version').val() === 2 && newData.child('owner_uid').val() === auth.uid && newData.child('publicado').val() === 'espera' && newData.child('estado_aprobacion').val() === 'pendiente')"
        }
      }
    },

    "bingoRooms":           { ".read": true, ".write": true },
    "bingoRoomCodes":       { ".read": true, ".write": true },
    "bingoRoomMemberships": { ".read": true, ".write": true },

    "rifas_otps": {
      "$tel": {
        ".read": false,
        ".write": true,
        ".validate": "newData.hasChildren(['codigo','expira_en','tipo','telefono','intent','intentos']) && newData.child('codigo').isString() && newData.child('codigo').val().length >= 40 && newData.child('intentos').isNumber() && newData.child('intentos').val() >= 0 && newData.child('intentos').val() <= 5"
      }
    },

    "rifas_usuarios": {
      ".read": true,
      "$tel": {
        ".write": true,
        ".validate": "newData.hasChildren(['telefono','nombre'])"
      }
    },

    "rifas": {
      ".read": true,
      ".indexOn": ["creador_key"],
      "$rifa": {
        ".write": true,
        "numeros": {
          ".read": true,
          "$num": { ".write": true }
        },
        "vendedores": {
          ".read": true,
          "$vk": { ".write": true }
        }
      }
    },

    "vendedor_index": {
      "$tel": { ".read": true, ".write": true }
    },

    "creador_index": {
      "$tel": { ".read": true, ".write": true }
    }
  }
}
